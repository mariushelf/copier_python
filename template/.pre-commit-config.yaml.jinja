minimum_pre_commit_version: "3.2.0"
default_stages: [pre-commit]
default_install_hook_types: [pre-commit, post-commit, post-checkout, post-merge, post-rewrite]
repos:
- repo: https://github.com/charliermarsh/ruff-pre-commit
  # Ruff version.
  rev: 'v0.14.10'
  hooks:
  - id: ruff
    args: [--fix, --exit-non-zero-on-fix]
    types_or: [python, pyi]
  - id: ruff-format
- repo: https://github.com/adrienverge/yamllint.git
  rev: v1.35.1
  hooks:
  - id: yamllint
    args: [-d, "{extends: relaxed, rules: {line-length: disable} }"]
    verbose: true
- repo: local
  hooks:
  - id: ty
    name: ty check
    entry: uv run ty check
    language: system
    files: ^src/.*\.py$
    exclude: ^src/legacy/.*\.py$
{%- if include_hexagonal %}
  - id: lint_imports
    name: lint imports
    entry: uv run lint-imports
    language: system
    pass_filenames: false
{%- endif %}
  - id: graphify
    name: graphify update
    entry: sh scripts/graphify-update.sh
    language: system
    stages: [post-commit, post-checkout, post-merge, post-rewrite]
    always_run: true
    pass_filenames: false
- repo: https://github.com/gitleaks/gitleaks
  rev: v8.30.1
  hooks:
  - id: gitleaks
